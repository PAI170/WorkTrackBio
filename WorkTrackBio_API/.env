# NOTA: He corregido la DATABASE_URL.
# Para una conexión de confianza (Trusted Connection) a una instancia con nombre,
# esta es la estructura correcta. No es necesario codificar la barra invertida '\'.
# SQLAlchemy y pyodbc se encargarán de interpretarla correctamente.

DATABASE_URL=mssql+pyodbc://localhost\EMPLOYEESDB/WTB_DB?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes


